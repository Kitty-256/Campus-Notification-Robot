# ===== notice-svc =====
# 相对路径按「仓库根目录」解析；Docker 里由 compose 覆盖成 /data/...
DB_PATH=data/notice.db
SOURCES_FILE=data/sources.yaml

# 管理接口的令牌：调用 /api/admin/* 时放在请求头 X-Admin-Token
ADMIN_TOKEN=change-me

# 时区（影响"当天日报"的判定）
TZ=Asia/Shanghai

# ===== LLM（留空则自动走降级摘要，不影响系统跑通）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ===== 抓取节奏（秒）=====
CRAWL_INTERVAL_MIN=60
CRAWL_DELAY_MIN=1
CRAWL_DELAY_MAX=3
